@startuml UML部署图
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam ArrowColor #344054
skinparam ArrowFontColor #5A6272
skinparam dpi 150
skinparam node {
  BackgroundColor #F7FAFC
  BorderColor #344054
  FontSize 11
}
skinparam database {
  BackgroundColor #EEF4FA
  BorderColor #344054
}
skinparam cloud {
  BackgroundColor #FEF7F0
  BorderColor #344054
}
skinparam artifact {
  BackgroundColor #FFFFFF
  BorderColor #667085
  FontSize 11
}
skinparam note {
  BackgroundColor #FFF8E6
  BorderColor #E4B363
  FontSize 10
}

node "用户终端\n微信内置浏览器" as CLIENT {
  artifact "顾客端 H5" as A1
  artifact "商家端 H5" as A2
  artifact "配送端 H5" as A3
}
node "管理端 PC 浏览器" as ADMIN {
  artifact "管理后台" as A4
}

node "接入服务器\n2C4G" as EDGE {
  artifact "Nginx\nTLS 1.2+" as NGX
}

node "应用服务器 4C8G ×2\n无状态" as APP {
  artifact "校园食刻应用\n账号·商品·交易·履约" as JAR
  artifact "定时任务\n选主执行" as SCHED
}

database "MySQL 8.0\n主库 + 从库" as DB
node "Redis 6\n缓存·库存·幂等键" as REDIS
node "消息队列\n事件·延迟消息" as MQ
node "对象存储\n菜品图片" as OSS
cloud "支付平台\n沙箱／微信支付" as PAY

CLIENT --> NGX : HTTPS 443
ADMIN --> NGX : HTTPS 443
NGX --> APP : 反向代理 8080
APP --> DB : JDBC 3306
APP --> REDIS : 6379
APP --> MQ : 5672
APP --> OSS : HTTPS
SCHED --> DB
SCHED --> MQ
APP --> PAY : 下单／退款
PAY --> APP : 回调（验签）

note right of APP
  应用无状态：会话与幂等键放 Redis，
  两台实例可水平扩展；
  定时任务用数据库锁选主，
  避免超时取消被重复执行。
end note
note bottom of PAY
  支付回调是订单状态变更的唯一依据（REQ-007）
end note
@enduml
