@startuml UML组件图
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam componentStyle rectangle
skinparam ArrowColor #344054
skinparam ArrowFontColor #5A6272
skinparam dpi 150
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #344054
  FontSize 11
}
skinparam package {
  BackgroundColor #FBFCFE
  BorderColor #B9C4D4
  FontColor #1F3B63
  FontSize 12
}
skinparam database {
  BackgroundColor #EEF4FA
  BorderColor #344054
}
skinparam queue {
  BackgroundColor #F7FAFC
  BorderColor #344054
}
hide stereotype
top to bottom direction

package "接入组件" #F1F5FB {
  component "顾客端" as CUS
  component "商家端" as MER
  component "配送端" as RID
  component "管理后台" as ADM
}

package "业务组件" #F7FAFC {
  component "API 网关\n鉴权·限流·幂等键" as GW
  component "账号与权限" as ACC
  component "商品·库存" as CAT
  component "订单" as ORD
  component "支付与退款" as PAY
  component "配送" as DSP
  component "通知" as NTF
  component "统计" as RPT
  component "审计" as AUD
}

package "基础设施组件" #F6F2FB {
  database "MySQL" as DB
  component "Redis" as CACHE
  queue "消息队列" as MQ
  component "支付适配" as CH
}

CUS --> GW
MER --> GW
RID --> GW
ADM --> GW

GW ..> ACC : 鉴权
GW ..> CAT : 菜品
GW ..> ORD : 下单
GW ..> DSP : 配送
GW ..> RPT : 统计
GW ..> AUD : 审计

ORD ..> CAT : 库存扣减
ORD ..> PAY : 创建支付
ORD ..> NTF : 支付成功
ORD ..> AUD : 写日志
PAY ..> CH : 渠道调用
DSP ..> ORD : 状态回写
RPT ..> ORD : 只读查询

ORD --> DB
CAT --> DB
DSP --> DB
AUD --> DB
CAT --> CACHE
ORD --> MQ
MQ ..> NTF
MQ ..> DSP

note bottom of AUD
  写操作与日志同事务提交：业务成功而日志缺失视为失败（REQ-019）
end note
@enduml
