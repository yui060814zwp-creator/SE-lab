@startuml UML活动图
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam ArrowColor #344054
skinparam ArrowFontColor #5A6272
skinparam dpi 150
skinparam activity {
  BackgroundColor #F7FAFC
  BorderColor #344054
  FontSize 11
  DiamondBackgroundColor #FFF8E6
  DiamondBorderColor #B5813B
}
skinparam swimlane {
  BorderColor #B9C4D4
  TitleFontSize 12
  TitleFontColor #1F3B63
}

|顾客|
start
:筛选菜品;
:加购物车;
:提交订单;
|订单服务|
:校验地址·幂等·库存;
if (通过?) then (否)
  :回滚并提示原因;
  |顾客|
  :购物车保留;
  stop
else (是)
  |订单服务|
  :生成订单与快照;
  :返回支付参数;
endif
|支付平台|
:收银台支付;
:异步回调;
|订单服务|
:验签与幂等;
if (通过?) then (否)
  :告警，状态不变;
  stop
else (是)
  :改状态为待接单;
  :写流水与日志;
  :发布支付成功事件;
endif
|商家|
:待接单提醒;
if (5 分钟内接单?) then (是)
  :订单进入制作中;
  stop
else (否)
  |定时任务|
  :自动取消并全额退款;
  stop
endif
@enduml
