@startuml UML状态图
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam ArrowColor #344054
skinparam ArrowFontColor #5A6272
skinparam dpi 150
skinparam state {
  BackgroundColor #F7FAFC
  BorderColor #344054
  FontSize 12
  AttributeFontSize 11
}
skinparam note {
  BackgroundColor #FFF8E6
  BorderColor #E4B363
  FontSize 10
}
state "待支付" as S1
state "待接单" as S2
state "制作中" as S3
state "待配送" as S4
state "配送中" as S5
state "已完成" as S6
state "已取消" as S7
state "已关闭" as S8
state "已退款" as S9

[*] --> S1 : 提交订单
S1 --> S2 : 支付回调成功
S1 --> S8 : 超时 15 分钟／顾客取消
S2 --> S3 : 商家接单
S2 --> S7 : 商家拒单
S2 --> S7 : 超时 5 分钟
S2 --> S7 : 顾客取消
S3 --> S4 : 商家出餐
S3 --> S7 : 商家同意取消
S4 --> S5 : 分配成功
S4 --> S7 : 商家取消
S4 --> S7 : 顾客申请经同意
S5 --> S6 : 点击送达
S5 --> S7 : 配送失败
S5 --> S6 : 改为自取
S7 --> S9 : 退款回执成功
S6 --> [*]
S8 --> [*]
S9 --> [*]

note bottom of S7
  "已取消"是订单终结，"已退款"是资金终结：
  退款失败时订单停在"已取消"，由退款单
  标记失败并进入人工队列（REQ-011）。
  并发冲突以行锁下先落库者为准，后到者返回 409。
end note
@enduml
