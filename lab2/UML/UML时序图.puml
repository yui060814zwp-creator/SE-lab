@startuml UML时序图
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam dpi 150
skinparam sequence {
  ArrowColor #344054
  LifeLineBorderColor #98A2B3
  ParticipantBackgroundColor #EAF1FA
  ParticipantBorderColor #344054
  ParticipantFontSize 11
  GroupBackgroundColor #F7FAFC
  GroupBorderColor #98A2B3
  NoteBackgroundColor #FFF8E6
  NoteBorderColor #E4B363
}
skinparam note {
  FontSize 10
}

autonumber "<b>0"
participant "顾客" as U
participant "顾客端 H5" as H5
participant "订单服务" as ORD
participant "库存服务" as STK
participant "支付服务" as PAY
participant "支付平台" as PLAT
participant "商家端" as SHOP

U -> H5 : 提交订单
H5 -> ORD : POST /orders（幂等键）
ORD -> ORD : 校验地址与购物车
ORD -> STK : 扣减库存（同事务）
alt 库存不足
  STK --> ORD : 缺货规格
  ORD --> H5 : 409，整单回滚
  H5 --> U : 提示缺货，购物车保留
else 库存充足
  ORD --> H5 : 订单号与支付参数
  H5 -> U : 跳转收银台
  U -> PLAT : 完成支付
  PLAT -> PAY : 异步回调（验签）
  group 回调：验签 → 幂等 → 同事务改状态
    PAY -> ORD : 确认支付结果
    alt 渠道交易号已处理
      ORD --> PAY : 幂等返回
    else 首次回调
      ORD -> ORD : 待支付→待接单，写流水与日志
      ORD --> PAY : 成功
    end
  end
  ORD -> SHOP : 支付成功事件
  SHOP --> U : 待接单（5 分钟未接单自动退款）
end
note over ORD, PAY
  只认服务端回调，客户端"支付完成"跳转不作为依据（REQ-007）
end note
@enduml
