@startuml UML包图
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam packageStyle rectangle
skinparam ArrowColor #2B3445
skinparam ArrowFontColor #5A6272
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #2B3445
  FontColor #1F3B63
  FontSize 13
}
skinparam note {
  BackgroundColor #FFF8E6
  BorderColor #E4B363
  FontSize 11
}

package "表现层 presentation" as PRES #F3F6FB {
  package "顾客端 H5\n（微信内置浏览器）" as P1
  package "商家端 H5" as P2
  package "配送端 H5" as P3
  package "平台管理后台" as P4
  package "统一网关\n鉴权·限流·幂等键·埋点" as P5
}

package "应用层 application" as APP #EEF4FA {
  package "身份与权限\naccount" as A1
  package "店铺与商品\ncatalog" as A2
  package "交易\ntrade" as A3
  package "履约\nfulfillment" as A4
  package "查询与统计\nreport" as A5
  package "运营与审计\nops" as A6
}

package "领域层 domain" as DOM #EAF5EE {
  package "订单领域\n状态机·价格快照" as D1
  package "库存与定价\nstock" as D2
  package "配送调度\ndispatch" as D3
  package "结算与退款\nsettlement" as D4
  package "权限策略\npolicy" as D5
}

package "基础设施层 infrastructure" as INF #F6F2FB {
  package "MySQL\n主数据与事务" as I1
  package "Redis\n缓存·库存·幂等键" as I2
  package "消息队列\n事件·重试" as I3
  package "支付适配层\n沙箱／微信支付" as I4
  package "定时任务\n超时·对账·归档" as I5
  package "对象存储\n菜品图片" as I6
}

P1 ..> P5 : HTTPS
P2 ..> P5
P3 ..> P5
P4 ..> P5

P5 ..> A1
P5 ..> A2
P5 ..> A3
P5 ..> A4
P5 ..> A5
P5 ..> A6

A1 ..> D5
A2 ..> D2
A3 ..> D1
A3 ..> D2
A3 ..> D4
A4 ..> D1
A4 ..> D3
A5 ..> D1
A6 ..> D5

D1 ..> I1
D2 ..> I1
D2 ..> I2
D3 ..> I1
D3 ..> I2
D4 ..> I4
D4 ..> I1
I5 ..> I1

note right of P5
  依赖方向自上而下：
  上层只依赖下层提供的接口，
  领域层通过端口接口访问基础设施，
  更换支付渠道或缓存实现不影响上层代码。
end note

note bottom of D1
  D1 是全局唯一的状态裁决点：
  订单、支付、配送、退款、库存
  五个对象的状态变更在此校验后
  由同一事务提交（REQ-021）。
end note
@enduml
