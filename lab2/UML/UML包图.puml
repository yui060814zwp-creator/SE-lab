@startuml UML包图
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam packageStyle rectangle
skinparam ArrowColor #344054
skinparam ArrowFontColor #5A6272
skinparam dpi 150
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #344054
  FontColor #1F3B63
  FontSize 12
}
skinparam note {
  BackgroundColor #FFF8E6
  BorderColor #E4B363
  FontSize 10
}
hide stereotype

package "表现层" as PRES #F1F5FB {
  package "顾客端 H5" as P1
  package "商家端 H5" as P2
  package "配送端 H5" as P3
  package "管理后台" as P4
  package "统一网关" as P5
}

package "应用层" as APP #EEF4FA {
  package "身份与权限" as A1
  package "店铺与商品" as A2
  package "交易" as A3
  package "履约" as A4
  package "查询与统计" as A5
  package "运营与审计" as A6
}

package "领域层" as DOM #EAF5EE {
  package "订单领域" as D1
  package "库存与定价" as D2
  package "配送调度" as D3
  package "结算与退款" as D4
  package "权限策略" as D5
}

package "基础设施层" as INF #F6F2FB {
  package "MySQL" as I1
  package "Redis" as I2
  package "消息队列" as I3
  package "支付适配" as I4
  package "定时任务" as I5
  package "对象存储" as I6
}

P1 ..> P5
P2 ..> P5
P3 ..> P5
P4 ..> P5

P5 ..> A1
P5 ..> A2
P5 ..> A3
P5 ..> A4
P5 ..> A5
P5 ..> A6

A1 ..> D5
A2 ..> D2
A3 ..> D1
A3 ..> D2
A3 ..> D4
A4 ..> D1
A4 ..> D3
A5 ..> D1
A6 ..> D5

D1 ..> I1
D2 ..> I1
D2 ..> I2
D3 ..> I1
D3 ..> I2
D4 ..> I1
D4 ..> I4
I5 ..> I1

note right of D1
  订单领域是全局唯一的状态裁决点：
  订单、支付、配送、退款、库存五个对象
  的状态变更在此校验，由同一事务提交（REQ-021）。
end note
note left of I4
  依赖只向下：支付渠道、缓存实现可替换，
  上层代码不变（REQ-024 的适配层要求）。
end note
@enduml
