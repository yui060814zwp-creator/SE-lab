@startuml UML类图
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam ArrowColor #344054
skinparam ArrowFontColor #5A6272
skinparam dpi 150
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #344054
  HeaderBackgroundColor #EAF1FA
  FontSize 13
  AttributeFontSize 11
}
skinparam package {
  BackgroundColor #FBFCFE
  BorderColor #B9C4D4
  FontColor #1F3B63
  FontSize 13
}

package "账号与权限" #F1F5FB {
  abstract class 账号 {
    # 账号ID : String
    # 手机号 : String
    # 密码哈希 : String
    # 角色 : 角色枚举
    + 登录(验证码) : 凭证
    + 校验数据归属(对象) : Boolean
  }
  class 顾客 {
    + 提交订单(购物车) : 订单
  }
  class 商家 {
    + 接单(订单) : void
    + 拒单(订单, 原因) : void
  }
  class 配送人员 {
    + 抢单(配送单) : Boolean
  }
  class 平台管理员 {
    + 作废订单(订单, 原因) : void
  }
}

package "店铺与商品" #F2F8F4 {
  class 店铺 {
    + 名称 : String
    + 营业状态 : 营业状态
    + 配送半径 : Integer
    + 可下单(地址) : Boolean
  }
  class 菜品 {
    + 名称 : String
    + 上架状态 : Boolean
    + 最低价() : Money
  }
  class 规格 {
    + 名称 : String
    + 价格 : Money
    + 库存 : Integer
    + 扣减(数量) : void
  }
}

package "交易与履约" #FEF7F0 {
  class 收货地址 {
    + 联系人 : String
    + 手机号 : String
    + 是否默认 : Boolean
    + 距店铺(店铺) : Integer
  }
  class 购物车项 {
    + 数量 : Integer
    + 小计() : Money
  }
  class 订单 {
    + 订单号 : String
    + 状态 : 订单状态
    + 应付金额 : Money
    + 幂等键 : String
    + 提交(购物车) : 订单
    + 变更状态(事件) : void
  }
  class 订单明细 {
    + 菜品名快照 : String
    + 单价快照 : Money
    + 数量 : Integer
  }
  class 支付单 {
    + 支付单号 : String
    + 渠道交易号 : String
    + 处理回调(回执) : Boolean
  }
  class 配送单 {
    + 配送单号 : String
    + 状态 : 配送状态
    + 指配(配送人员) : Boolean
  }
  class 退款单 {
    + 退款单号 : String
    + 金额 : Money
    + 状态 : 退款状态
  }
  class 状态流水 {
    + 原状态 : 订单状态
    + 新状态 : 订单状态
    + 时间 : DateTime
  }
}

package "领域服务" #FFFFFF {
  class 订单状态机 <<service>> {
    + 校验转换(订单, 事件) : Boolean
  }
}

账号 <|-- 顾客
账号 <|-- 商家
账号 <|-- 配送人员
账号 <|-- 平台管理员

商家 "1" -- "0..*" 店铺 : 经营
店铺 "1" *-- "1..*" 菜品 : 上架
菜品 "1" *-- "1..*" 规格 : 提供
顾客 "1" -- "0..*" 收货地址 : 维护
顾客 "1" -- "0..*" 购物车项 : 持有
规格 "1" -- "0..*" 购物车项 : 被加入
购物车项 "0..*" -- "1" 订单 : 结算生成
店铺 "1" -- "0..*" 订单 : 接收
顾客 "1" -- "0..*" 订单 : 提交
订单 "1" *-- "1..*" 订单明细 : 包含
订单明细 "1" --> "1" 规格 : 快照引用
订单 "1" -- "1" 支付单 : 对应
订单 "1" -- "1" 配送单 : 对应
订单 "1" -- "0..*" 退款单 : 产生
订单 "1" -- "1..*" 状态流水 : 追加
配送人员 "1" -- "0..*" 配送单 : 持有
订单状态机 ..> 订单 : 裁决

note right of 订单明细
  价格与名称在提交时写成快照，
  之后菜品改价不影响本单
end note
note bottom of 状态流水
  只追加、不修改：每次状态变更
  写一条，用于状态机校验与追溯
end note
@enduml
