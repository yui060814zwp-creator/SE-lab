@startuml UML类图
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam ArrowColor #344054
skinparam ArrowFontColor #5A6272
skinparam dpi 150
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #344054
  HeaderBackgroundColor #EAF1FA
  FontSize 12
  AttributeFontSize 11
}
skinparam package {
  BackgroundColor #FBFCFE
  BorderColor #B9C4D4
  FontColor #1F3B63
  FontSize 12
}
hide stereotype

package "交易" #FEF7F0 {
  class 顾客 {
    + 手机号 : String
    + 提交订单(购物车) : 订单
  }
  class 购物车项 {
    + 数量 : Integer
  }
  class 订单 {
    + 订单号 : String
    + 状态 : 订单状态
    + 幂等键 : String
    + 提交(购物车) : 订单
    + 变更状态(事件) : void
  }
  class 订单明细 {
    + 菜品名快照 : String
    + 单价快照 : Money
    + 数量 : Integer
  }
}

package "结算与履约" #F7FAFC {
  class 支付单 {
    + 渠道交易号 : String
    + 处理回调(回执) : Boolean
  }
  class 配送单 {
    + 配送单号 : String
    + 状态 : 配送状态
    + 指配(配送人员) : Boolean
  }
  class 退款单 {
    + 退款单号 : String
    + 金额 : Money
  }
  class 状态流水 {
    + 原状态 : 订单状态
    + 新状态 : 订单状态
    + 时间 : DateTime
  }
}

package "引用" #F2F8F4 {
  class 规格 {
    + 价格 : Money
    + 库存 : Integer
    + 扣减(数量) : void
  }
}

package "领域服务" #FFFFFF {
  class 订单状态机 <<service>> {
    + 校验转换(订单, 事件) : Boolean
  }
}

顾客 "1" -- "0..*" 购物车项 : 持有
顾客 "1" -- "0..*" 订单 : 提交
购物车项 "0..*" ..> "1" 订单 : 结算生成
订单 "1" *-- "1..*" 订单明细 : 包含
订单明细 "1" --> "1" 规格 : 快照引用
订单 "1" -- "1" 支付单 : 对应
订单 "1" -- "1" 配送单 : 对应
订单 "1" -- "0..*" 退款单 : 产生
订单 "1" -- "1..*" 状态流水 : 追加
订单状态机 ..> 订单 : 裁决

note right of 订单明细
  快照：提交时写入菜品名与单价，
  之后改价只影响新订单
end note
note bottom of 状态流水
  只追加不修改：每次状态变更一条
end note
@enduml
